{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "megafon-intraservice",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "INTRASERVICE_URL": "https://yfo-skfo.intraservice.ru",
    "IS_SERVICE_ID": "619",
    "IS_TYPE_ID": "1024",
    "IS_PRIORITY_ID": "11",
    "IS_STATUS_DONE_ID": "29",
    "IS_CREATOR_ID": "1744"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "megafon-intraservice",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "secrets": {
    "required": [
      "MEGAFON_CRM_TOKEN",
      "WEBHOOK_SECRET_PATH",
      "INTRASERVICE_LOGIN",
      "INTRASERVICE_PASSWORD"
    ]
  }
}
